# Copy this file to .env and edit the values for your machine.
#
# Absolute path to the cloned project directory. Do not quote the value.
# Windows example:
# YEELIGHT_CODEX_ROOT=C:\Users\you\Documents\Codex\yeelight-codex-music-hooks
#
# macOS/Linux-style paths are fine if you adapt the scripts for that platform:
# YEELIGHT_CODEX_ROOT=/Users/you/Projects/yeelight-codex-music-hooks
YEELIGHT_CODEX_ROOT=C:\Users\you\path\to\yeelight-codex-music-hooks

# Python executable used by Codex hooks.
# Usually "python" on Windows, but you can use an absolute path if needed.
YEELIGHT_CODEX_PYTHON=python
